# ===== LLM 大模型配置 =====
COMPLETION_API_KEY=your-api-key-here
COMPLETION_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
COMPLETION_MODEL=qwen3.5-plus
COMPLETION_MAX_TOKEN=4096
COMPLETION_ENABLE_THINKING=False
COMPLETION_TEMPERATURE=0.1
COMPLETION_STREAMING=True

# ===== 知识库配置 =====
KNOWLEDGE_BASE_URI=https://aix.toone.com.cn/v1
KNOWLEDGE_API_KEY=your-knowledge-api-key
KNOWLEDGE_DATASET=公路工程-行业标准库
KNOWLEDGE_TOP_K=10

# ===== Neo4j 图数据库配置 =====
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=neo4j

# ===== 安全配置 =====
SECRET_KEY=change-me-to-a-random-string
ADMIN_API_KEY_ENABLE=True
ADMIN_API_KEY=your-admin-api-key

# ===== 数据库配置（PostgreSQL）=====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-db-password
DB_DATABASE=dify

# ===== Celery 消息队列配置 =====
CELERY_BACKEND=database
CELERY_BROKER_URL=

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_FILE=

# ===== 运行模式 =====
MODE=api
FLASK_DEBUG=0
DEBUG=False

# ===== 登录配置 =====
ENABLE_EMAIL_PASSWORD_LOGIN=True
ALLOW_REGISTER=False
ALLOW_CREATE_WORKSPACE=False

# ===== 服务端点配置 =====
SERVICE_API_URL=
CONSOLE_API_URL=
CONSOLE_WEB_URL=

# ===== 可选：邮箱配置 =====
# MAIL_TYPE=smtp
# MAIL_DEFAULT_SEND_FROM=noreply@example.com
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=False

